# Primary OpenAI-compatible vLLM endpoint used by src/kingpro.
KINGPRO_LLM_BASE_URL=http://127.0.0.1:8000/v1
KINGPRO_LLM_API_KEY=EMPTY
KINGPRO_LLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct
KINGPRO_LLM_TIMEOUT=150
# Runtime egress gate: exact hosts only. Remote endpoints must use HTTPS;
# localhost/loopback vLLM may use HTTP. Add a host only after provider review.
KINGPRO_ALLOWED_ENDPOINT_HOSTS=127.0.0.1,localhost,::1,api.runpod.ai
# Fail closed for free-form generation. Set true only after checking the exact
# checkpoint/revision and endpoint readiness before the demo session.
KINGPRO_LLM_ATTESTED=false
KINGPRO_MODEL_SIZE_LIMIT_BILLION=15
KINGPRO_MODEL_RELEASE_CUTOFF=2026-06-01
KINGPRO_REGISTRY_PARAPHRASE_MIN_SCORE=0.78
KINGPRO_REGISTRY_PARAPHRASE_MIN_CANDIDATE_RECALL=0.75
KINGPRO_REGISTRY_PARAPHRASE_MIN_QUERY_PRECISION=0.65
KINGPRO_REGISTRY_PARAPHRASE_MIN_MARGIN=0.12
KINGPRO_REGISTRY_PARAPHRASE_MIN_SHARED_TERMS=4
# Runtime compliance gate. Chỉ thêm checkpoint khi đã có bằng chứng giấy phép
# và số tham số nằm trong ngưỡng BTC xác nhận.
KINGPRO_ALLOWED_MODELS=Qwen/Qwen2.5-Coder-14B-Instruct
KINGPRO_HOST=127.0.0.1
KINGPRO_PORT=8080
KINGPRO_ALLOWED_ORIGIN=http://127.0.0.1:3000
KINGPRO_MIN_GROUNDING_CONFIDENCE=0.90
KINGPRO_MAX_TABLES=24
KINGPRO_VOTE_COUNT=2
KINGPRO_MIN_VOTE_RATIO=0.5
KINGPRO_EXECUTION_TIMEOUT=6
# Optional audited replay registry. Exact hits and uniquely safe paraphrases
# are re-executed and source-bound; every other question uses retrieval/model.
KINGPRO_REPLAY_SUBMISSION=sub_v297_scope2/submission.json

# Compatibility aliases used by older experiment scripts.
BASE_CODER=http://127.0.0.1:8000/v1
MODEL_CODER=Qwen/Qwen2.5-Coder-14B-Instruct
