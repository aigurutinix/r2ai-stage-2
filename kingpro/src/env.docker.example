# Ports published only on 127.0.0.1 by compose.yaml.
KINGPRO_FRONTEND_PUBLISHED_PORT=3000
KINGPRO_BACKEND_PUBLISHED_PORT=8080

# Authentication modes: off (loopback demo), token, oidc.
KINGPRO_AUTH_MODE=off
KINGPRO_API_TOKENS_JSON="{}"
KINGPRO_SERVICE_TOKEN=""
KINGPRO_OIDC_ISSUER=""
KINGPRO_OIDC_AUDIENCE=""
KINGPRO_OIDC_JWKS_URL=""

# Set a strong secret outside version control to authenticate the audit chain.
KINGPRO_AUDIT_HMAC_KEY=""
KINGPRO_DATA_ENCRYPTION_KEY=""
KINGPRO_REQUIRE_DATA_ENCRYPTION=false
KINGPRO_UPLOAD_REQUIRE_MALWARE_SCANNER=true
KINGPRO_MAX_BATCH_ITEMS=2000
KINGPRO_MAX_ACTIVE_JOBS_PER_TENANT=2
KINGPRO_REQUIRE_OS_SANDBOX=false
KINGPRO_OS_SANDBOX_PROVIDER=auto
KINGPRO_OS_SANDBOX_ATTESTED=false

# Optional dynamic open-model runtime. Leave blank for the verified
# replay/compiler/fail-closed Stage-safe product.
# From a container, use host.docker.internal instead of 127.0.0.1 when the
# OpenAI-compatible model server runs on the Windows host.
KINGPRO_LLM_BASE_URL=
KINGPRO_LLM_MODEL=
KINGPRO_LLM_API_KEY=""
KINGPRO_LLM_ATTESTED=false
KINGPRO_ALLOWED_ENDPOINT_HOSTS=
