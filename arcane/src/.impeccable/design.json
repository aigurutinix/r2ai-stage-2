  "narrative": {
    "northStar": "The Workbench",
    "overview": "A dark, quiet workspace where the answer and the evidence that produced it are on screen at the same time, permanently. Near-black ground with three lifted greys, separated by hairlines rather than shadows, and one hot orange carrying every interactive signal. Not a chat transcript: the workspace splits into an answer column and an evidence column, both always visible, and opening a table swaps the evidence column in place so the answer never moves. Three faces divide the work by what they can spell.",
    "keyCharacteristics": [
      "Two permanent panes; evidence is never behind a drawer or below the fold.",
      "Hairlines and flat greys carry structure. No shadows anywhere.",
      "One orange, used only for interaction, state and the cited cell.",
      "Type is assigned by script coverage, not by taste.",
      "The question is a command line, not a bubble."
    ],
    "rules": [
      {
        "name": "The One-Orange Rule",
        "body": "If an element wants a colour it wants attention, and attention here is orange or nothing. No success green, no warning amber, no danger red.",
        "section": "colors"
      },
      {
        "name": "The Hairline Rule",
        "body": "Structure is a 1px #2E2E2E division. Shadows do not exist in this system.",
        "section": "elevation"
      },
      {
        "name": "The Script Rule",
        "body": "A face is chosen by what it can spell. Fragment Mono and Doto never receive Vietnamese text; any string that might carry a tone mark is Manrope's.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep both panes visible. Evidence behind a drawer defeats the product.",
      "Do send every Vietnamese string to Manrope.",
      "Do right-align numeric columns and set them in Fragment Mono.",
      "Do merge streaming evidence by table id so visible cards do not jump."
    ],
    "donts": [
      "Don't add a second accent colour.",
      "Don't add a shadow; structure is hairlines.",
      "Don't put Vietnamese text in Doto or Fragment Mono; the glyphs are not in the subsets.",
      "Don't return the layout to a chat transcript."
    ]
  }
