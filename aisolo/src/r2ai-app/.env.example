# Sao chép file này thành .env.local rồi điền giá trị.

# Auth (server-only). SESSION_SECRET >= 32 ký tự (tạo bằng: openssl rand -base64 32)
# Tự đặt tài khoản đăng nhập của bạn — KHÔNG có giá trị mặc định, để repo công khai không lộ
# thông tin đăng nhập vào bản triển khai của bạn.
SESSION_SECRET=
ADMIN_USER=
ADMIN_PASS=

# LLM — Qwen3.5-4B chạy LOCAL qua Ollama
#   Hợp lệ cuộc thi: mã nguồn mở (Apache-2.0), <= 14B (~4.66B), GGUF upload 02/03/2026 (trước mốc 31/05/2026).
#   Cài: ollama run hf.co/unsloth/Qwen3.5-4B-GGUF:Q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-4B-GGUF:Q4_K_M

# Embedding + Reranker (Stage-2 retrieval — chưa wire vào app, dùng sau 01/08):
#   EMBED_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0   (qua Ollama; 1024d)
#   Reranker: TÙY CHỌN — chạy transformers Python (Qwen3-Reranker-0.6B / bge-reranker-v2-m3),
#   chỉ dùng nếu test cho thấy tăng F2; KHÔNG dùng bản GGUF.
