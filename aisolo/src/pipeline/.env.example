# LLM engine — custom Modal app (vLLM trên A10G, KHÔNG cần thẻ) sinh pandas cho câu hard-conditional.
# Deploy:  python -m modal deploy modal_app.py   → lấy URL:  python -m modal app list
# Copy file này thành .env rồi điền URL:
LLM_BASE_URL=https://<workspace>--r2ai-llm-serve.modal.run/v1
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LLM_API_KEY=<tự đặt một chuỗi ngẫu nhiên, khớp với khoá đã deploy trên Modal>
LLM_NO_THINK=0
# Bật engine khi build:  USE_LLM=1 python build_submission.py
